{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kalshi-bot",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",

  // The trading loop lives in one Durable Object with its own SQLite database.
  "durable_objects": {
    "bindings": [{ "name": "BOT", "class_name": "Bot" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Bot"] }],

  // Once a minute, make sure the loop is running (it restarts itself after deploys).
  "triggers": { "crons": ["* * * * *"] },

  "observability": { "enabled": true },

  // Plain settings. Secrets (API key, private key, dashboard password) go in
  // the Cloudflare dashboard under Settings -> Variables and Secrets, never here.
  "vars": {
    "BOT_MODE": "paper",            // paper | demo | live
    "LIVE_TRADING_CONFIRM": "",     // must be "yes" for live
    "TRADE_HORIZON": "day",         // starting time limit: 15m | hour | day | week | month | any
    "BOT_TIMEZONE": "America/New_York",
    "POLL_SECONDS": "5",

    "CRYPTO_ENABLED": "true",
    "ARB_ENABLED": "true",
    "CRYPTO_ASSETS": "BTC,ETH,SOL,XRP,DOGE",
    "SERIES_PER_TICK": "3",
    "LIVE_STREAMS": "true",         // live websocket prices from Coinbase + Kraken (Workers Paid)

    "MIN_EDGE": "0.04",
    "MIN_PRICE": "0.15",            // only bet between 15¢ and 85¢ (editable on the dashboard)
    "MAX_PRICE": "0.85",
    "MIN_ARB_PROFIT": "0.02",
    "KELLY_FRACTION": "0.25",
    "MODEL_WEIGHT": "0.5",          // blend: 1 = trust the crypto model fully, 0.5 = halfway to the market price
    "MAKER_STRATEGIES": "crypto,sports,ai", // rest post-only bids instead of paying the taker fee; "none" = always take the ask
    "MAKER_TTL_SECONDS": "120",     // crypto: cancel an unfilled bid after 2 minutes
    "MAKER_MAX_CHASE": "0.03",      // crypto: a resting bid may follow the price up by at most 3¢ in total
    "HYBRID_TAKE": "true",          // buy at the ask right away when the edge still clears the bar after the taker fee
    "EXIT_ENABLED": "true",         // crypto: sell a position when the model turns against it
    "EXIT_MARGIN": "0.03",          // ...if the bid beats the model's value by 3¢+ per contract after fees
    "MAKER_SLOW_TTL_SECONDS": "1800", // sports and AI: 30 minutes (sports bids always cancel before the game)
    "MIN_SECONDS_LEFT": "60",

    // Sports: Kalshi game prices vs sportsbook odds (needs the ODDS_API_KEY secret from the-odds-api.com)
    "SPORTS_ENABLED": "true",
    "SPORTS_LIST": "americanfootball_ncaaf", // college football only; add more Odds API keys (comma-separated) to widen
    "SPORTS_MIN_EDGE": "0.03",
    "SPORTS_INTERVAL_MINUTES": "30",
    "SPORTS_REGIONS": "eu,us",      // eu includes Pinnacle; each region costs 1 credit per sport per check
    "SPORTS_DAILY_CREDITS": "16",   // ~480/month, fits the free plan; raise if you buy a bigger plan

    // PrizePicks finder (dashboard tab): PrizePicks lines vs sportsbook player props, both from
    // The Odds API (PrizePicks is its "us_dfs" region). Read-only: it never places entries.
    "PRIZEPICKS_ENABLED": "true",
    "PRIZEPICKS_SPORTS": "americanfootball_ncaaf",   // also: americanfootball_nfl, basketball_nba, baseball_mlb, icehockey_nhl…
    "PRIZEPICKS_MARKETS": "player_pass_yds,player_rush_yds,player_reception_yds",
    "PRIZEPICKS_REGIONS": "us,us_dfs",  // us = sportsbooks, us_dfs = PrizePicks
    "PRIZEPICKS_DAILY_CREDITS": "300",  // safety ceiling; each game costs markets × regions credits (6 with the defaults)
    "PRIZEPICKS_INTERVAL_MINUTES": "0",  // 0 = only when you tap "Check now" (saves credits); e.g. 120 = every 2 hours
    "PRIZEPICKS_HOURS_AHEAD": "24",
    "PRIZEPICKS_MIN_BOOKS": "1",
    "PRIZEPICKS_POWER_PAYOUTS": "2:3,3:5,4:10,5:20,6:37.5", // set to what your PrizePicks app shows

    // AI forecaster for slower, non-crypto markets (needs the ANTHROPIC_API_KEY secret)
    "AI_ENABLED": "true",
    "AI_MODEL": "claude-sonnet-5-5",
    "AI_MIN_EDGE": "0.05",          // after blending with the market, so Claude must disagree by ~13¢+
    "AI_INTERVAL_MINUTES": "30",    // at most one forecast every 30 minutes, so the budget lasts all day
    "AI_REFRESH_HOURS": "6",        // re-forecast a market at most every 6 hours
    "AI_MIN_VOLUME": "1000",        // skip thin markets (contracts traded in 24h)
    "AI_MIN_HOURS_TO_CLOSE": "2",
    "AI_DAILY_BUDGET": "2",         // dollars of AI spend per day; editable on the dashboard
    "MIN_SECONDS_ELAPSED": "60",

    // Starting spending limits in dollars. Change them any time on the dashboard.
    "BANKROLL": "100",
    "MAX_CONTRACTS_PER_ORDER": "10",
    "MAX_COST_PER_ORDER": "5",
    "MAX_COST_PER_MARKET": "10",
    "MAX_COST_PER_EVENT": "20",
    "MAX_OPEN_RISK": "50",
    "MAX_DAILY_LOSS": "25",
    "MAX_ORDERS_PER_MARKET": "3"         // bets per market (adds to a position, never the opposite side); 1 = never add
  }
}
