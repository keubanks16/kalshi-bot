# Copy to .env and fill in.  cp .env.example .env

# paper = real prices, simulated fills, no keys needed (start here)
# demo  = real orders on Kalshi's demo exchange (fake money)
# live  = real money; also requires LIVE_TRADING_CONFIRM=yes
BOT_MODE=paper
LIVE_TRADING_CONFIRM=

# From kalshi.com (or demo.kalshi.co) -> Account -> API Keys.
# Demo and production keys are different.
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=kalshi_private_key.pem

# Strategy
MIN_EDGE=0.04
KELLY_FRACTION=0.25
MIN_SECONDS_LEFT=120
MIN_SECONDS_ELAPSED=60

# Risk limits (dollars)
BANKROLL=100
MAX_CONTRACTS_PER_ORDER=10
MAX_COST_PER_MARKET=10
MAX_DAILY_LOSS=25
MAX_ORDERS_PER_MARKET=3

# Dashboard
DASHBOARD_PASSWORD=
FLASK_SECRET_KEY=replace-with-a-long-random-string
BOT_TIMEZONE=America/New_York
